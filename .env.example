# Anthropic API key. Server-only (lib/ai/*, route handlers) — never exposed to the browser.
ANTHROPIC_API_KEY=

# Supabase service role key. Read only by scripts/seed.ts — never set this on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project URL. Public (RLS is the authorisation layer, D1) — safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Public (RLS is the authorisation layer, D1) — safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The app's own deployed URL (e.g. https://zenda.vercel.app), used in Supabase auth redirects.
NEXT_PUBLIC_APP_URL=

# The demo clock (A12). YYYY-MM-DD. Set only for the demo (e.g. 2026-10-20); unset for real time.
DEMO_TODAY=
